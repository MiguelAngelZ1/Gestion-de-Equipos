generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model componentes_instalados {
  id                          Int                           @id @default(autoincrement())
  equipo_id                   String
  repuesto_id                 Int?
  nombre                      String
  ine                         String?
  nne                         String?
  serie                       String?
  fecha_instalacion           DateTime?                     @default(now())
  especificacion_id           Int?
  componentes_repuestos       componentes_repuestos?        @relation(fields: [repuesto_id], references: [id], onUpdate: NoAction)
  equipos                     equipos?                      @relation(fields: [equipo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  especificaciones            especificaciones?             @relation(fields: [especificacion_id], references: [id], onUpdate: NoAction)
  especificaciones_instaladas especificaciones_instaladas[]

  @@index([equipo_id])
  @@index([repuesto_id])
}

model componentes_repuestos {
  id                         Int                          @id @default(autoincrement())
  nombre                     String
  ine                        String?
  nne                        String?
  serie                      String?
  cantidad                   Int?                         @default(0)
  estado                     String?
  fecha_ingreso              DateTime?                    @default(now())
  equipo_id                  String?
  componentes_instalados     componentes_instalados[]
  equipos                    equipos?                     @relation(fields: [equipo_id], references: [id], onUpdate: NoAction)
  especificaciones_repuestos especificaciones_repuestos[]
  movimientos_stock          movimientos_stock[]

  @@index([equipo_id])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model equipos {
  id               String            @id
  ine              String
  nne              String?
  serie            String?
  categoria_id     Int?
  ubicacion_id     Int?
  responsable_id   Int?
  estado_id        Int?
  is_deleted       Boolean?          @default(false)
  created_at       DateTime?         @default(now())
  updated_at       DateTime?         @default(now())
  estados          estados?          @relation(fields: [estado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responsables     responsables?     @relation(fields: [responsable_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ubicaciones      ubicaciones?      @relation(fields: [ubicacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grupos_comodidad grupos_comodidad? @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tareas_soporte   tareas_soporte[]
  componentes_instalados componentes_instalados[]
  componentes_repuestos  componentes_repuestos[]
  historial_personal     historial_personal[]
  movimientos_stock      movimientos_stock[]
  soporte_tareas         soporte_tareas[]
  prestamos             prestamos[]
  especificaciones      especificaciones[]

  @@index([categoria_id])
  @@index([ubicacion_id])
  @@index([estado_id])
  @@index([is_deleted])
}

model prestamos {
  id                        Int       @id @default(autoincrement())
  equipo_id                 String
  solicitante               String
  motivo                    String?
  fecha_prestamo            DateTime  @default(now())
  fecha_devolucion_estimada DateTime?
  fecha_devolucion_real     DateTime?
  estado                    String    @default("ACTIVO") // ACTIVO, DEVUELTO
  notas                     String?
  equipos                   equipos   @relation(fields: [equipo_id], references: [id], onDelete: Cascade)
}

// La tabla equipos_v3 se ha unificado con equipos

model especificaciones {
  id                     Int                      @id @default(autoincrement())
  equipo_id              String
  clave                  String
  valor                  String
  componentes_instalados componentes_instalados[]
  equipos                equipos?                 @relation(fields: [equipo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model especificaciones_instaladas {
  id                     Int                    @id @default(autoincrement())
  instalacion_id         Int
  clave                  String
  valor                  String
  componentes_instalados componentes_instalados @relation(fields: [instalacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model especificaciones_repuestos {
  id                    Int                   @id @default(autoincrement())
  repuesto_id           Int
  clave                 String
  valor                 String
  componentes_repuestos componentes_repuestos @relation(fields: [repuesto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model estados {
  id         Int          @id @default(autoincrement())
  nombre     String       @unique(map: "sqlite_autoindex_estados_1")
  color_hex  String?
  equipos    equipos[]
}

model grados {
  id             Int    @id @default(autoincrement())
  abreviatura    String @unique(map: "sqlite_autoindex_grados_1")
  grado_completo String
  responsables   responsables[]
}

model grupos_comodidad {
  id         Int          @id @default(autoincrement())
  nombre     String       @unique(map: "sqlite_autoindex_grupos_comodidad_1")
  equipos    equipos[]
}

model historial_personal {
  id              Int       @id @default(autoincrement())
  equipo_id       String
  responsable     String
  evento          String
  estado_anterior String?
  estado_nuevo    String?
  fecha           DateTime? @default(now())
  notas           String?
  equipos         equipos?  @relation(fields: [equipo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model movimientos_stock {
  id                    Int                   @id @default(autoincrement())
  repuesto_id           Int
  tipo                  String
  cantidad              Int
  equipo_id             String?
  soporte_id            Int?
  fecha                 DateTime?             @default(now())
  notas                 String?
  soporte_tareas        soporte_tareas?       @relation(fields: [soporte_id], references: [id], onUpdate: NoAction)
  equipos               equipos?              @relation(fields: [equipo_id], references: [id], onUpdate: NoAction)
  componentes_repuestos componentes_repuestos @relation(fields: [repuesto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model responsables {
  id             Int              @id @default(autoincrement())
  grado          String
  grado_id       Int?
  nombre         String
  apellido       String
  dni            String?          @unique
  telefono       String?
  email          String?
  activo         Int?             @default(1)
  grados         grados?          @relation(fields: [grado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  equipos        equipos[]
  tareas_soporte tareas_soporte[]
}

model soporte_tareas {
  id                Int                 @id @default(autoincrement())
  ticket_id         String              @unique(map: "sqlite_autoindex_soporte_tareas_1")
  equipo_id         String
  responsable       String
  tarea_realizada   String
  fecha             DateTime?           @default(now())
  updated_at        DateTime?           @default(now())
  tipo_falla        String?
  costo_estimado    Float?              @default(0)
  movimientos_stock movimientos_stock[]
  equipos           equipos?            @relation(fields: [equipo_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([equipo_id])
}

model tareas_soporte {
  id              Int           @id @default(autoincrement())
  equipo_id       String?
  responsable_id  Int?
  usuario_id      Int?
  tarea_realizada String
  fecha           DateTime?     @default(now())
  usuarios        usuarios?     @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responsables    responsables? @relation(fields: [responsable_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  equipos         equipos?      @relation(fields: [equipo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ubicaciones {
  id         Int          @id @default(autoincrement())
  ubicacion  String       @unique(map: "sqlite_autoindex_ubicaciones_1")
  nombre     String?
  equipos    equipos[]
}

model usuarios {
  id             Int              @id @default(autoincrement())
  usuario        String
  email          String           @unique(map: "sqlite_autoindex_usuarios_1")
  password_hash  String
  rol            String?          @default("USER")
  permisos_json  String?          @default("[]")
  last_login     DateTime?
  created_at     DateTime?        @default(now())
  updated_at     DateTime?        @default(now())
  tareas_soporte    tareas_soporte[]
  push_subscriptions push_subscriptions[]
  alertas_notificaciones alertas_notificaciones[]
  mensajes_admin         mensajes_admin[]
}

model sync_metadata {
  id         Int       @id @default(autoincrement())
  clave      String    @unique
  valor      String?
  updated_at DateTime? @default(now())
}

model sync_logs {
  id                   Int       @id @default(autoincrement())
  tipo                 String
  direccion            String?
  equipos_creados      Int?      @default(0)
  equipos_actualizados Int?      @default(0)
  equipos_eliminados   Int?      @default(0)
  errores              String?
  exitoso              Boolean?  @default(true)
  fecha                DateTime? @default(now())
}

model alertas_notificaciones {
  id         Int       @id @default(autoincrement())
  usuario_id Int?
  titulo     String
  mensaje    String
  tipo       String?   @default("sistema")
  leido      Boolean?  @default(false)
  fecha      DateTime? @default(now())
  usuario    usuarios? @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

model push_subscriptions {
  id                Int      @id @default(autoincrement())
  usuario_id        Int
  subscription_json String
  device_info       String?
  created_at        DateTime @default(now())
  usuario           usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}

model mensajes_admin {
  id         Int       @id @default(autoincrement())
  usuario_id Int?
  remitente  String?
  mensaje    String
  leido      Boolean?  @default(false)
  fecha      DateTime? @default(now())
  usuarios   usuarios? @relation(fields: [usuario_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model recuperacion_claves {
  id      Int      @id @default(autoincrement())
  email   String   @unique
  codigo  String
  expires DateTime
}
