# =============================================================================
# CONFIGURACIÓN - Control de Equipos 3.0
# =============================================================================
# Copia este archivo como .env y completa los valores.
# NUNCA comitees el .env real. Está en .gitignore por seguridad.

# ========== GENERACIÓN DE SECRETOS ==========
# Genera un JWT_SECRET seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# El resultado DEBE tener al menos 32 caracteres y NO debe ser una palabra conocida.
JWT_SECRET=<generar_con_comando_arriba>

# Password del admin inicial (se crea automáticamente al primer inicio):
# NO debe ser 'admin123'. Usa una contraseña segura de al menos 12 caracteres.
ADMIN_PASSWORD=<tu_password_seguro_admin>

# ========== EMAIL (Recuperación de contraseña) ==========
# Credenciales de Gmail para Nodemailer.
# Usa una "App Password" de Google (no la contraseña normal):
# https://myaccount.google.com/apppasswords
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ========== GOOGLE DRIVE (Backups) ==========
# Sigue el tutorial de OAuth2 para generar estas credenciales:
# https://developers.google.com/drive/api/quickstart/nodejs
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_REFRESH_TOKEN=tu_refresh_token

# ========== PUSH NOTIFICATIONS (PWA) ==========
# Genera VAPID keys con:
#   npx web-push generate-vapid-keys
# Luego asigna:
#   VAPID_PUBLIC_KEY=<publicKey>
#   VAPID_PRIVATE_KEY=<privateKey>
VAPID_PUBLIC_KEY=tu_vapid_public_key
VAPID_PRIVATE_KEY=tu_vapid_private_key
VAPID_SUBJECT=mailto:tu_correo@gmail.com

# ========== TELEGRAM BOT ==========
# Token de BotFather para el bot de Telegram
# Obtén uno en https://t.me/BotFather
TELEGRAM_BOT_TOKEN=tu_token_de_botfather

# IDs de Telegram (separados por coma) que pueden usar el bot
# Obtén tu ID escribiendo a @userinfobot en Telegram
TELEGRAM_ALLOWED_USERS=tu_id_de_telegram

# Clave de invitación para acceso temporal al bot.
# Si se configura, los usuarios no autorizados pueden ingresar esta clave
# para obtener acceso. Se autorizan automáticamente en la DB.
# Déjalo vacío para deshabilitar el acceso por invitación.
# TELEGRAM_INVITE_PASSWORD=clave_segura_temporal

# ========== SUPABASE (Producción) ==========
# Connection string de Supabase Postgres.
# LOCAL: no configurar (usa SQLite).
# PRODUCTION: configurar con la URL de tu proyecto Supabase.
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# ========== GEMINI AI ==========
GEMINI_API_KEY=tu_gemini_api_key

# ========== OTROS ==========
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
