# =============================================================================
# CONFIGURACIÓN LOCAL - Control de Equipos 3.0
# =============================================================================
# Copia este archivo como .env y ajusta los valores

# --- BASE DE DATOS (SQLite local) ---
DATABASE_URL="file:./equipos.db"

# --- SEGURIDAD ---
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET="<generated_hex_value>"
# ⚠️ IMPORTANTE: Cambia JWT_SECRET y ADMIN_PASSWORD antes de producción.
# JWT_SECRET debe tener al menos 32 caracteres.
# ADMIN_PASSWORD no debe ser 'admin123' y debe tener al menos 8 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(12).toString('base64'))"
# ADMIN_PASSWORD="<generated_base64_value>"

# --- EMAIL (Gmail con App Password) ---
# EMAIL_USER="tu_email@gmail.com"
# EMAIL_PASS="xxxx xxxx xxxx xxxx"

# --- NOTIFICACIONES PUSH (VAPID) ---
# Generar con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY="tu_clave_publica"
# VAPID_PRIVATE_KEY="tu_clave_privada"

# --- GOOGLE DRIVE BACKUP (OAuth2) ---
# GOOGLE_DRIVE_FOLDER_ID="id_carpeta"
# GOOGLE_CLIENT_ID="tu_client_id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="tu_client_secret"
# GOOGLE_REFRESH_TOKEN="tu_refresh_token"

# --- API KEY GEMINI (IA - Opcional) ---
# API_KEY_GEMINI="tu_api_key"

# --- PUERTO ---
# PORT=3000

# --- CONFIGURACIÓN OPERATIVA ---
# DELAY_REPAIR_DAYS=2
# LOW_STOCK_THRESHOLD=5
# NOTIFICATION_CHECK_HOURS=12
# LOCAL_FRONTEND_URL="http://localhost:5173"
