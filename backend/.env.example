# =============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - Control de Equipos 3.0
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL (Railway)
# -----------------------------------------------------------------------------
# Obtén estas variables de tu proyecto en Railway:
# 1. Ve a tu proyecto en railway.app
# 2. Selecciona el servicio de PostgreSQL
# 3. Click en "Variables" para ver las credenciales

DATABASE_URL="postgres://usuario:password@hostname:port/database"
DATABASE_PUBLIC_URL="postgres://usuario:password@hostname:port/database"

# -----------------------------------------------------------------------------
# EMAIL (Gmail con App Password)
# -----------------------------------------------------------------------------
# EMAIL_USER="tu_email@gmail.com"
# EMAIL_PASS="xxxx xxxx xxxx xxxx"  (App Password de Gmail)

# -----------------------------------------------------------------------------
# NOTIFICACIONES PWA
# -----------------------------------------------------------------------------
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="tu_clave_publica_aqui"
VAPID_PRIVATE_KEY="tu_clave_privada_aqui"

# -----------------------------------------------------------------------------
# SEGURIDAD
# -----------------------------------------------------------------------------
# Genera una clave segura aleatoria para producción
# JWT_SECRET="cadena_aleatoria_muy_larga_para_produccion"
# ADMIN_PASSWORD="tu_contraseña_admin_segura"

# -----------------------------------------------------------------------------
# PUERTO (Railway configura esto automáticamente)
# -----------------------------------------------------------------------------
# PORT=3000

# -----------------------------------------------------------------------------
# BASE DE DATOS LOCAL (Prisma/SQLite - solo para desarrollo)
# -----------------------------------------------------------------------------
# PRISMA_DATABASE_URL="file:../equipos.db"

# -----------------------------------------------------------------------------
# GOOGLE DRIVE BACKUP (OAuth2)
# -----------------------------------------------------------------------------
# Obtener ejecutando: node scripts/getRefreshToken.js
# GOOGLE_DRIVE_FOLDER_ID="id_carpeta_google_drive"
# GOOGLE_CLIENT_ID="tu_client_id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="tu_client_secret"
# GOOGLE_REFRESH_TOKEN="tu_refresh_token"

# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# CONFIGURACIÓN OPERATIVA (OPCIONAL)
# -----------------------------------------------------------------------------
# VAPID_SUBJECT="mailto:admin@imperio.cl"
# DELAY_REPAIR_DAYS=2           # Días antes de alertar por equipo en taller
# LOW_STOCK_THRESHOLD=5         # Umbral para alerta de stock bajo
# NOTIFICATION_CHECK_HOURS=12   # Frecuencia de chequeo de alertas
# LOCAL_FRONTEND_URL="http://localhost:5173"
# DB_PATH="prisma/equipos.db"

# API KEY GEMINI (IA - Opcional)
# -----------------------------------------------------------------------------
# API_KEY_GEMINI="tu_api_key_gemini"
