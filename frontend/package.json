{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "powershell -ExecutionPolicy Bypass -Command \"$m=$env:VITE_PORTABLE_MODE; if([string]::IsNullOrEmpty($m)){$m='full'}; & ../scripts/sync-portable.ps1 -SkipBuild -SkipInstall -Mode $m\"",
    "lint": "eslint . --max-warnings 200",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
