{
  "name": "control-equipos-3",
  "version": "2026.1.0",
  "private": true,
  "scripts": {
    "build": "cd backend && pnpm install && cd ../frontend && pnpm install && pnpm run build",
    "start": "cd backend && pnpm start",
    "portable:sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-portable.ps1",
    "portable:quick": "powershell -ExecutionPolicy Bypass -File scripts/sync-portable.ps1 -SkipBuild -SkipInstall",
    "build:portable": "pnpm run build && pnpm run portable:sync"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
